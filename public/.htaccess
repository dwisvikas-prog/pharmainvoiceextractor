# index.html must never be cached by the browser - it's what points at the
# current hashed JS/CSS bundle, so a stale cached copy keeps loading the old
# app until a manual hard refresh. The hashed files under assets/ already
# change name on every build, so those are safe to cache long-term.

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
