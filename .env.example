# Server-side only (set these in Vercel project settings, NOT with a VITE_
# prefix) - used by api/gemini-ocr.js. Never exposed to the browser.
GEMINI_API_KEY=your_api_key_here
# Optional extra keys for rotation when a key hits 429/503:
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Client-side (VITE_ prefix is fine here - the anon key is designed to be
# public; real protection is the Row Level Security rules in
# supabase/schema.sql). Set the same two in Vercel too.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Server-side only. Lets the admin + payment serverless functions
# (api/admin-*.js, api/razorpay-*.js) bypass Row Level Security using
# service_role-only Postgres functions (see supabase/admin_and_payments.sql).
# Get it from Supabase dashboard -> Project Settings -> API -> service_role key.
# NEVER put this behind a VITE_ prefix - it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server-side only. Shared secret for the hidden /#admin panel (manual/cash
# payment grants). Pick a long random string - this is effectively a master
# password for granting access, so keep it out of chat logs, screenshots, etc.
ADMIN_PASSCODE=choose_a_long_random_secret

# Server-side only. A SEPARATE random secret used only to sign admin session
# tokens - never reuse ADMIN_PASSCODE here. Rotate this alone to invalidate
# every existing admin session without changing the login passcode.
ADMIN_TOKEN_SECRET=choose_a_different_long_random_secret

# Server-side only, used by api/razorpay-create-order.js and
# api/razorpay-verify-payment.js. Get these from the Razorpay dashboard
# (Settings -> API Keys). Test-mode keys work for development; switch to
# live keys only once you've verified full flow end to end.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
